APP_NAME=NAVIGEN API
APP_ENV=development
DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000
API_V1_PREFIX=/api/v1
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
FRONTEND_ORIGINS=http://localhost:5173
UGV_BRIDGE_URL=ws://localhost:9090
# Set to a registered robots.id to enable automatic telemetry ingestion.
UGV_ROBOT_ID=
# Optional until the TrackingState ROS topic is finalized by the UGV contract.
UGV_LOCALIZATION_TOPIC=
UGV_CONNECTION_TIMEOUT_SECONDS=5
TELEMETRY_STALE_THRESHOLD_MS=2000
TELEMETRY_PERSISTENCE_ENABLED=true
TELEMETRY_PERSISTENCE_RATE_HZ=2
WEBSOCKET_QUEUE_SIZE=100
WEBSOCKET_MAX_DROPPED_MESSAGES=25
WEBSOCKET_AUTH_TIMEOUT_SECONDS=5

# Read-only HTTP MJPEG camera source. The URL stays on the backend.
# For ROS web_video_server, e.g. http://<vehicle-host>:8080/stream?topic=/camera/image_raw&type=mjpeg
CAMERA_STREAM_URL=
CAMERA_TIMEOUT_SECONDS=8
CAMERA_MAX_VIEWERS=4
CAMERA_MAX_FRAME_BYTES=4194304
