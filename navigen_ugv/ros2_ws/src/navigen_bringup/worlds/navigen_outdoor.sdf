<?xml version="1.0"?>
<sdf version="1.9">
  <world name="navigen_outdoor">
    <physics name="navigen_physics" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <gravity>0 0 -9.81</gravity>
    <magnetic_field>0.000006 0.000023 -0.000042</magnetic_field>
    <scene>
      <ambient>0.45 0.45 0.42 1</ambient>
      <background>0.55 0.72 0.88 1</background>
      <shadows>true</shadows>
    </scene>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.86 0.76 1</diffuse>
      <specular>0.25 0.25 0.25 1</specular>
      <direction>-0.4 0.2 -0.9</direction>
    </light>

    <model name="terrain">
      <static>true</static>
      <link name="ground">
        <collision name="ground_collision">
          <geometry><plane><normal>0 0 1</normal><size>30 20</size></plane></geometry>
          <surface>
            <friction><ode><mu>1.2</mu><mu2>0.9</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="ground_visual">
          <geometry><plane><normal>0 0 1</normal><size>30 20</size></plane></geometry>
          <material><ambient>0.24 0.32 0.16 1</ambient><diffuse>0.30 0.40 0.20 1</diffuse></material>
        </visual>
        <visual name="dirt_path">
          <pose>3 0 0.006 0 0 0</pose>
          <geometry><box><size>14 2.4 0.01</size></box></geometry>
          <material><ambient>0.38 0.28 0.16 1</ambient><diffuse>0.48 0.36 0.22 1</diffuse></material>
        </visual>
        <visual name="dry_patch_left">
          <pose>1.5 3.4 0.007 0 0 0.18</pose>
          <geometry><box><size>4.5 2.2 0.011</size></box></geometry>
          <material><ambient>0.42 0.36 0.18 1</ambient><diffuse>0.53 0.45 0.23 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="central_box_obstacle">
      <static>true</static>
      <pose>3.2 0.35 0.35 0 0 0.15</pose>
      <link name="box">
        <collision name="collision"><geometry><box><size>0.65 0.65 0.7</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.65 0.65 0.7</size></box></geometry>
          <material><ambient>0.52 0.25 0.08 1</ambient><diffuse>0.68 0.34 0.10 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="low_box_obstacle">
      <static>true</static>
      <pose>5.3 -0.55 0.18 0 0 -0.25</pose>
      <link name="box">
        <collision name="collision"><geometry><box><size>0.8 0.5 0.36</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.8 0.5 0.36</size></box></geometry>
          <material><ambient>0.38 0.22 0.10 1</ambient><diffuse>0.52 0.30 0.12 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="rock_cluster">
      <static>true</static>
      <pose>6.4 1.65 0 0 0 0</pose>
      <link name="rocks">
        <collision name="rock_a_collision">
          <pose>0 0 0.28 0 0 0</pose>
          <geometry><sphere><radius>0.28</radius></sphere></geometry>
        </collision>
        <visual name="rock_a_visual">
          <pose>0 0 0.28 0 0 0</pose>
          <geometry><sphere><radius>0.28</radius></sphere></geometry>
          <material><ambient>0.27 0.25 0.23 1</ambient><diffuse>0.38 0.35 0.31 1</diffuse></material>
        </visual>
        <collision name="rock_b_collision">
          <pose>0.42 0.12 0.20 0 0 0</pose>
          <geometry><sphere><radius>0.20</radius></sphere></geometry>
        </collision>
        <visual name="rock_b_visual">
          <pose>0.42 0.12 0.20 0 0 0</pose>
          <geometry><sphere><radius>0.20</radius></sphere></geometry>
          <material><ambient>0.23 0.22 0.21 1</ambient><diffuse>0.34 0.32 0.30 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="tree_left">
      <static>true</static>
      <pose>2.0 4.0 0 0 0 0</pose>
      <link name="tree">
        <collision name="trunk_collision">
          <pose>0 0 0.8 0 0 0</pose>
          <geometry><cylinder><radius>0.18</radius><length>1.6</length></cylinder></geometry>
        </collision>
        <visual name="trunk_visual">
          <pose>0 0 0.8 0 0 0</pose>
          <geometry><cylinder><radius>0.18</radius><length>1.6</length></cylinder></geometry>
          <material><ambient>0.25 0.12 0.05 1</ambient><diffuse>0.38 0.19 0.08 1</diffuse></material>
        </visual>
        <visual name="canopy_visual">
          <pose>0 0 1.9 0 0 0</pose>
          <geometry><sphere><radius>0.85</radius></sphere></geometry>
          <material><ambient>0.08 0.28 0.07 1</ambient><diffuse>0.12 0.43 0.10 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="tree_right">
      <static>true</static>
      <pose>7.0 -3.6 0 0 0 0</pose>
      <link name="tree">
        <collision name="trunk_collision">
          <pose>0 0 0.75 0 0 0</pose>
          <geometry><cylinder><radius>0.16</radius><length>1.5</length></cylinder></geometry>
        </collision>
        <visual name="trunk_visual">
          <pose>0 0 0.75 0 0 0</pose>
          <geometry><cylinder><radius>0.16</radius><length>1.5</length></cylinder></geometry>
          <material><ambient>0.24 0.12 0.05 1</ambient><diffuse>0.36 0.18 0.07 1</diffuse></material>
        </visual>
        <visual name="canopy_visual">
          <pose>0 0 1.75 0 0 0</pose>
          <geometry><sphere><radius>0.75</radius></sphere></geometry>
          <material><ambient>0.08 0.25 0.07 1</ambient><diffuse>0.11 0.39 0.09 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="shallow_ramp">
      <static>true</static>
      <pose>8.0 2.8 0.10 0 0.08 0</pose>
      <link name="ramp">
        <collision name="collision"><geometry><box><size>2.2 1.4 0.18</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>2.2 1.4 0.18</size></box></geometry>
          <material><ambient>0.34 0.30 0.20 1</ambient><diffuse>0.45 0.40 0.26 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
