[Unit]
Description=NAVIGEN Pi camera and ESP8266 dashboard for %i
After=network.target

[Service]
Type=simple
User=%i
WorkingDirectory=/home/%i/navigen_dashboard
Environment=ESP8266_PORT=/dev/ttyUSB0
ExecStart=/usr/bin/python3 /home/%i/navigen_dashboard/navigen_ugv/pi_controller/app.py --port ${ESP8266_PORT} --http-port 8080 --bind 0.0.0.0 --token-file /home/%i/.config/navigen/dashboard.token
Restart=on-failure
RestartSec=3
Environment=PYTHONUNBUFFERED=1
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
